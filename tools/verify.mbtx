----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/fs",
}
----

fn report_field(value : Json, key : String) -> Json {
  guard value is Object(fields) else { abort("report object missing") }
  fields.get(key).unwrap()
}

async fn main {
  let args = @env.args()
  guard args.length() == 2 && ["wasm", "wasm-gc", "js", "native"].contains(args[1]) else {
    abort("usage: moon run tools/verify.mbtx <wasm|wasm-gc|js|native>")
  }
  let target = args[1]
  for command in [
    ["check", "--target", target, "--deny-warn"],
    ["test", "--target", target, "--deny-warn"],
    ["run", "packages/check", "--target", target, "--deny-warn", "--", "examples/repository.har", "examples/repository.requests.json"],
    ["run", "packages/review", "--target", target, "--deny-warn", "--", "examples/repository.har", "examples/repository.har"],
    ["run", "packages/check", "--target", target, "--deny-warn", "--", "examples/repository-gzip.har", "examples/repository.requests.json", "--decoded"],
    ["run", "packages/branch_demo", "--target", target, "--deny-warn", "--", "examples/repository.har"],
  ] {
    @shell.Cmd("moon", command, stdout=Inherit, stderr=Inherit).run()
  }
  if target != "wasm-gc" {
    @shell.Cmd("moon", ["run", "packages/demo", "--target", target, "--deny-warn", "--", "examples/repository.har"], stdout=Inherit, stderr=Inherit).run()
  }
  let temporary = "_build/echoreel-negative-manifest.json"
  for (plan, expected) in [
    ("[{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"}]", "request_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_status\":404}]", "status_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_stauts\":200}]", "manifest_error"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"body\":123}]", "manifest_error"),
    ("[]", "unconsumed"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_body\":\"wrong\"}]", "response_body_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_headers\":[{\"name\":\"content-type\",\"values\":[]}]}]", "response_header_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_body_base64\":\"Zh==\"}]", "manifest_error"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/private\",\"value\":true}]}]", "response_json_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/missing\",\"value\":null}]}]", "response_json_missing"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/~invalid\",\"value\":null}]}]", "invalid_expectation"),
  ] {
    @fs.write_string_to_file(temporary, plan)
    let output = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary]).output()
    assert_true(output.exit_code() != 0)
    assert_eq(output.exit_code(), if expected == "manifest_error" || expected == "invalid_expectation" { 2 } else { 1 })
    assert_true((output.stdout() + output.stderr()).contains(expected))
  }
  @fs.remove_file(temporary)
  @fs.write_string_to_file(temporary, "[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\"},{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"}]")
  let failed_plan = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary]).output()
  assert_eq(failed_plan.exit_code(), 1)
  assert_true(failed_plan.stdout().contains("$plan[1]"))
  assert_false(failed_plan.stdout().contains("0: status="))
  let failed_report = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--report"]).output()
  assert_eq(failed_report.exit_code(), 1)
  let report = @json.parse(failed_report.stdout())
  assert_eq(report_field(report, "passed"), Json(false))
  assert_eq(report_field(report_field(report, "consumption"), "consumed"), Json::array([]))
  assert_eq(report_field(report_field(report, "consumption"), "remaining"), Json([0]))
  assert_eq(report_field(report_field(report, "diagnostic"), "code"), Json("no_match"))
  assert_false(failed_report.stdout().contains("https://"))
  assert_false(failed_report.stdout().contains("moonbitlang"))
  @fs.write_string_to_file(temporary, "[{\"unknown\":true}]")
  let invalid_report = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--report"]).output()
  assert_eq(invalid_report.exit_code(), 2)
  let invalid = @json.parse(invalid_report.stdout())
  assert_eq(report_field(invalid, "consumption"), Json::null())
  assert_eq(report_field(report_field(invalid, "diagnostic"), "code"), Json("manifest_error"))
  @fs.write_string_to_file(temporary, "not HAR JSON")
  let bad_har = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", temporary, "examples/repository.requests.json", "--report"]).output()
  assert_eq(bad_har.exit_code(), 2)
  let bad = @json.parse(bad_har.stdout())
  assert_eq(report_field(bad, "consumption"), Json::null())
  assert_eq(report_field(report_field(bad, "diagnostic"), "code"), Json("invalid_json"))
  @fs.remove_file(temporary)
  for flags in [["--report"], ["--decoded", "--report"], ["--report", "--decoded"]] {
    let capture = if flags.contains("--decoded") { "examples/repository-gzip.har" } else { "examples/repository.har" }
    let command = ["run", "packages/check", "--target", target, "--", capture, "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    output.check()
    let report = @json.parse(output.stdout())
    assert_eq(report_field(report, "passed"), Json(true))
    assert_eq(report_field(report, "diagnostic"), Json::null())
    assert_eq(report_field(report_field(report, "consumption"), "remaining"), Json::array([]))
    assert_eq(report_field(report_field(report, "consumption"), "consumed"), Json([0]))
    guard report_field(report_field(report, "adaptations"), "header_changes") is Array(changes) else { abort("adaptation list missing") }
    assert_eq(changes.length(), if flags.contains("--decoded") { 2 } else { 0 })
  }
  for flags in [["--report", "--report"], ["--decoded", "--decoded", "--report"], ["--report", "--unknown"]] {
    let command = ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    assert_eq(output.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(output.stdout()), "diagnostic"), "code"), Json("usage_error"))
  }
  let revised = @json.parse(@fs.read_file_to_string("examples/repository.har"), preserve_number_repr=true)
  guard revised is { "log": { "entries": Array(entries), .. }, .. } else { abort("fixture entries missing") }
  guard entries[0] is { "response": Object(response), .. } else { abort("fixture response missing") }
  response.set("status", 404)
  let revised_path = "_build/echoreel-review-after.har"
  @fs.write_string_to_file(revised_path, revised.stringify())
  let review = @shell.Cmd("moon", ["run", "packages/review", "--target", target, "--", "examples/repository.har", revised_path]).output()
  assert_true(review.exit_code() != 0)
  assert_true(review.stdout().contains("\"kind\":\"status\""))
  @fs.remove_file(revised_path)
  println("verified \{target}: unit tests, real capture, SDK where supported, and CLI rejection paths")
}
