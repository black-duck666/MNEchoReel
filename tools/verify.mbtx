----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/fs",
}
----

fn report_field(value : Json, key : String) -> Json {
  guard value is Object(fields) else { abort("report object missing") }
  fields.get(key).unwrap()
}

async fn main {
  let args = @env.args()
  guard args.length() == 2 && ["wasm", "wasm-gc", "js", "native"].contains(args[1]) else {
    abort("usage: moon run tools/verify.mbtx <wasm|wasm-gc|js|native>")
  }
  let target = args[1]
  let prepared_path = "_build/echoreel-prepared-\{target}.json"
  for (capture, flags) in [("examples/repository.har", ["--assert-bodies"]), ("examples/repository-gzip.har", ["--decoded", "--assert-bodies"])] {
    if @fs.path_exists(prepared_path) { @fs.remove_file(prepared_path) }
    let command = ["run", "packages/prepare", "--target", target, "--", capture, prepared_path]
    command.append(flags)
    let prepared = @shell.Cmd("moon", command).output()
    prepared.check()
    assert_eq(report_field(@json.parse(prepared.stdout()), "steps"), Json(1))
    let original = @fs.read_file_to_string(prepared_path)
    let replay = ["run", "packages/check", "--target", target, "--", capture, prepared_path]
    if flags.contains("--decoded") { replay.push("--decoded") }
    @shell.Cmd("moon", replay).run()
    let existing = @shell.Cmd("moon", command).output()
    assert_eq(existing.exit_code(), 2)
    assert_true(existing.stdout().contains("output_exists"))
    assert_eq(@fs.read_file_to_string(prepared_path), original)
  }
  @fs.remove_file(prepared_path)
  for command in [
    ["check", "--target", target, "--deny-warn"],
    ["test", "--target", target, "--deny-warn"],
    ["run", "packages/check", "--target", target, "--deny-warn", "--", "examples/repository.har", "examples/repository.requests.json"],
    ["run", "packages/review", "--target", target, "--deny-warn", "--", "examples/repository.har", "examples/repository.har"],
    ["run", "packages/check", "--target", target, "--deny-warn", "--", "examples/repository-gzip.har", "examples/repository.requests.json", "--decoded"],
    ["run", "packages/branch_demo", "--target", target, "--deny-warn", "--", "examples/repository.har"],
  ] {
    @shell.Cmd("moon", command, stdout=Inherit, stderr=Inherit).run()
  }
  if target != "wasm-gc" {
    @shell.Cmd("moon", ["run", "packages/demo", "--target", target, "--deny-warn", "--", "examples/repository.har"], stdout=Inherit, stderr=Inherit).run()
  }
  let temporary = "_build/echoreel-negative-manifest.json"
  for (plan, expected) in [
    ("[{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"}]", "request_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_status\":404}]", "status_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_stauts\":200}]", "manifest_error"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"body\":123}]", "manifest_error"),
    ("[]", "unconsumed"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_body\":\"wrong\"}]", "response_body_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_headers\":[{\"name\":\"content-type\",\"values\":[]}]}]", "response_header_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_body_base64\":\"Zh==\"}]", "manifest_error"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/private\",\"value\":true}]}]", "response_json_mismatch"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/missing\",\"value\":null}]}]", "response_json_missing"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json_present\":[\"/missing\"]}]", "response_json_missing"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json_absent\":[\"/owner\"]}]", "response_json_present"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json_present\":\"/owner\"}]", "manifest_error"),
    ("[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\",\"expect_json\":[{\"pointer\":\"/~invalid\",\"value\":null}]}]", "invalid_expectation"),
  ] {
    @fs.write_string_to_file(temporary, plan)
    let output = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary]).output()
    assert_true(output.exit_code() != 0)
    assert_eq(output.exit_code(), if expected == "manifest_error" || expected == "invalid_expectation" { 2 } else { 1 })
    assert_true((output.stdout() + output.stderr()).contains(expected))
  }
  @fs.remove_file(temporary)
  @fs.write_string_to_file(temporary, "[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\"},{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"}]")
  let failed_plan = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary]).output()
  assert_eq(failed_plan.exit_code(), 1)
  assert_true(failed_plan.stdout().contains("$plan[1]"))
  assert_false(failed_plan.stdout().contains("0: status="))
  let failed_report = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--report"]).output()
  assert_eq(failed_report.exit_code(), 1)
  let report = @json.parse(failed_report.stdout())
  assert_eq(report_field(report, "passed"), Json(false))
  assert_eq(report_field(report_field(report, "consumption"), "consumed"), Json::array([]))
  assert_eq(report_field(report_field(report, "consumption"), "remaining"), Json([0]))
  assert_eq(report_field(report_field(report, "diagnostic"), "code"), Json("no_match"))
  assert_false(failed_report.stdout().contains("https://"))
  assert_false(failed_report.stdout().contains("moonbitlang"))
  let explanation = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--explain"]).output()
  assert_eq(explanation.exit_code(), 1)
  let explained = @json.parse(explanation.stdout())
  assert_eq(report_field(report_field(explained, "explanation"), "outcome"), Json("no_match"))
  assert_eq(report_field(report_field(explained, "explanation"), "remaining"), Json(0))
  assert_eq(report_field(report_field(explained, "consumption"), "remaining"), Json([0]))
  assert_false(explanation.stdout().contains("https://"))
  for flags in [["--explain"], ["--explain", "--report"], ["--report", "--explain"]] {
    let command = ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    output.check()
    assert_eq(report_field(@json.parse(output.stdout()), "explanation"), Json::null())
  }
  @fs.write_string_to_file(temporary, "[{\"unknown\":true}]")
  let invalid_report = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--report"]).output()
  assert_eq(invalid_report.exit_code(), 2)
  let invalid = @json.parse(invalid_report.stdout())
  assert_eq(report_field(invalid, "consumption"), Json::null())
  assert_eq(report_field(report_field(invalid, "diagnostic"), "code"), Json("manifest_error"))
  @fs.write_string_to_file(temporary, "not HAR JSON")
  let bad_har = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", temporary, "examples/repository.requests.json", "--report"]).output()
  assert_eq(bad_har.exit_code(), 2)
  let bad = @json.parse(bad_har.stdout())
  assert_eq(report_field(bad, "consumption"), Json::null())
  assert_eq(report_field(report_field(bad, "diagnostic"), "code"), Json("invalid_json"))
  @fs.remove_file(temporary)
  for flags in [["--report"], ["--decoded", "--report"], ["--report", "--decoded"]] {
    let capture = if flags.contains("--decoded") { "examples/repository-gzip.har" } else { "examples/repository.har" }
    let command = ["run", "packages/check", "--target", target, "--", capture, "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    output.check()
    let report = @json.parse(output.stdout())
    assert_eq(report_field(report, "passed"), Json(true))
    assert_eq(report_field(report, "diagnostic"), Json::null())
    assert_eq(report_field(report_field(report, "consumption"), "remaining"), Json::array([]))
    assert_eq(report_field(report_field(report, "consumption"), "consumed"), Json([0]))
    guard report_field(report_field(report, "adaptations"), "header_changes") is Array(changes) else { abort("adaptation list missing") }
    assert_eq(changes.length(), if flags.contains("--decoded") { 2 } else { 0 })
  }
  for flags in [["--report", "--report"], ["--decoded", "--decoded", "--report"], ["--report", "--unknown"]] {
    let command = ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    assert_eq(output.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(output.stdout()), "diagnostic"), "code"), Json("usage_error"))
  }
  for (mode, label) in [("ordered", "ordered"), ("by-request", "by_request"), ("per-request", "per_request")] {
    let output = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json", "--mode", mode, "--match-header", "Accept", "--report"]).output()
    output.check()
    assert_eq(report_field(report_field(@json.parse(output.stdout()), "consumption"), "mode"), Json(label))
  }
  for flags in [["--report", "--mode"], ["--report", "--mode", "invalid"], ["--report", "--mode", "ordered", "--mode", "by-request"], ["--report", "--match-header"], ["--report", "--match-header", "X", "--match-header", "x"]] {
    let command = ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    assert_eq(output.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(output.stdout()), "diagnostic"), "code"), Json("usage_error"))
  }
  @fs.write_string_to_file(temporary, "[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\"}]")
  let header_miss = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--mode", "per-request", "--match-header", "Accept", "--report"]).output()
  assert_eq(header_miss.exit_code(), 1)
  assert_eq(report_field(report_field(@json.parse(header_miss.stdout()), "diagnostic"), "code"), Json("no_match"))
  @fs.remove_file(temporary)
  let junit_path = "_build/echoreel-\{target}.xml"
  let negative_junit = "_build/echoreel-\{target}-negative.xml"
  for path in [junit_path, negative_junit] { if @fs.path_exists(path) { @fs.remove_file(path) } }
  let junit = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json", "--report", "--junit", junit_path]).output()
  junit.check()
  assert_eq(report_field(@json.parse(junit.stdout()), "passed"), Json(true))
  let xml = @fs.read_file_to_string(junit_path)
  assert_true(xml.contains("tests=\"2\" failures=\"0\" errors=\"0\" skipped=\"0\""))
  assert_false(xml.contains("https://"))
  // An existing output, including an aliased input path, is never overwritten.
  let existing = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json", "--report", "--junit", junit_path]).output()
  assert_eq(existing.exit_code(), 2)
  assert_eq(report_field(report_field(@json.parse(existing.stdout()), "diagnostic"), "code"), Json("output_exists"))
  assert_eq(@fs.read_file_to_string(junit_path), xml)
  @fs.write_string_to_file(temporary, "[{\"method\":\"GET\",\"url\":\"https://api.github.com/repos/moonbitlang/core\"},{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"},{\"method\":\"GET\",\"url\":\"https://wrong.invalid/\"}]")
  let negative = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--junit", negative_junit]).output()
  assert_eq(negative.exit_code(), 1)
  let failed_xml = @fs.read_file_to_string(negative_junit)
  assert_true(failed_xml.contains("tests=\"4\" failures=\"1\" errors=\"0\" skipped=\"2\""))
  assert_true(failed_xml.contains("name=\"step.1\"><failure"))
  assert_true(failed_xml.contains("name=\"step.2\"><skipped>"))
  assert_true(failed_xml.contains("name=\"committed\" value=\"false\""))
  assert_false(failed_xml.contains("https://"))
  @fs.write_string_to_file("_build/echoreel-\{target}-failure.xml", failed_xml)
  @fs.remove_file(negative_junit)
  @fs.write_string_to_file(temporary, "not a plan")
  let preflight = @shell.Cmd("moon", ["run", "packages/check", "--target", target, "--", "examples/repository.har", temporary, "--report", "--junit", negative_junit]).output()
  assert_eq(preflight.exit_code(), 2)
  assert_false(@fs.path_exists(negative_junit))
  @fs.remove_file(temporary)
  for flags in [["--report", "--junit"], ["--report", "--junit", "--decoded"], ["--report", "--junit", negative_junit, "--junit", negative_junit]] {
    let command = ["run", "packages/check", "--target", target, "--", "examples/repository.har", "examples/repository.requests.json"]
    command.append(flags)
    let output = @shell.Cmd("moon", command).output()
    assert_eq(output.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(output.stdout()), "diagnostic"), "code"), Json("usage_error"))
  }
  let revised = @json.parse(@fs.read_file_to_string("examples/repository.har"), preserve_number_repr=true)
  let suite_junit = "_build/echoreel-suite-\{target}.xml"
  let failed_suite_junit = "_build/echoreel-suite-\{target}-failure.xml"
  let preflight_junit = "_build/echoreel-suite-\{target}-preflight.xml"
  for path in [suite_junit, failed_suite_junit, preflight_junit] { if @fs.path_exists(path) { @fs.remove_file(path) } }
  let suite = @shell.Cmd("moon", ["run", "packages/suite", "--target", target, "--", "examples/regression.suite.json", "--junit", suite_junit]).output()
  suite.check()
  let suite_report = @json.parse(suite.stdout())
  assert_eq(report_field(suite_report, "passed"), Json(true))
  guard report_field(suite_report, "cases") is Array(results) else { abort("case results missing") }
  assert_eq(results.length(), 2)
  guard report_field(results[1], "adaptations") is Array(changes) else { abort("decoded audit missing") }
  assert_eq(changes.length(), 2)
  let suite_xml = @fs.read_file_to_string(suite_junit)
  assert_true(suite_xml.contains("testsuites tests=\"4\" failures=\"0\" errors=\"0\" skipped=\"0\""))
  assert_true(suite_xml.contains("name=\"identity.step.0\""))
  assert_true(suite_xml.contains("name=\"decoded.step.0\""))
  let guarded_output = @shell.Cmd("moon", ["run", "packages/suite", "--target", target, "--", "examples/regression.suite.json", "--junit", suite_junit]).output()
  assert_eq(guarded_output.exit_code(), 2)
  assert_eq(@fs.read_file_to_string(suite_junit), suite_xml)
  let suite_path = "_build/echoreel-suite-\{target}.json"
  let suite_plan = "_build/echoreel-suite-\{target}-requests.json"
  @fs.write_string_to_file(suite_plan, "[{\"method\":\"GET\",\"url\":\"https://wrong-secret.invalid/\"}]")
  let suite_value = @json.parse(@fs.read_file_to_string("examples/regression.suite.json"))
  guard suite_value is Array(cases) else { abort("suite cases missing") }
  guard cases[0] is Object(first) else { abort("case missing") }
  first.set("requests", Json(suite_plan))
  @fs.write_string_to_file(suite_path, suite_value.stringify())
  let failed_suite = @shell.Cmd("moon", ["run", "packages/suite", "--target", target, "--", suite_path, "--explain", "--junit", failed_suite_junit]).output()
  assert_eq(failed_suite.exit_code(), 1)
  guard report_field(@json.parse(failed_suite.stdout()), "cases") is Array(results) else { abort("case results missing") }
  assert_eq(results.length(), 2)
  assert_eq(report_field(report_field(results[0], "report"), "committed"), Json(false))
  assert_eq(report_field(report_field(results[1], "report"), "committed"), Json(true))
  assert_false(failed_suite.stdout().contains("wrong-secret"))
  assert_true(@fs.read_file_to_string(failed_suite_junit).contains("testsuites tests=\"4\" failures=\"1\" errors=\"0\" skipped=\"1\""))
  guard cases[1] is Object(second) else { abort("case missing") }
  second.set("unknown", true)
  @fs.write_string_to_file(suite_path, suite_value.stringify())
  let rejected = @shell.Cmd("moon", ["run", "packages/suite", "--target", target, "--", suite_path, "--junit", preflight_junit]).output()
  assert_eq(rejected.exit_code(), 2)
  assert_eq(report_field(@json.parse(rejected.stdout()), "cases"), Json::array([]))
  assert_false(@fs.path_exists(preflight_junit))
  for invalid_suite in ["[]", "{}", "[{}]", "[{\"name\":\"x\",\"har\":\"examples/repository.har\",\"requests\":\"examples/repository.requests.json\",\"decoded\":1}]", "[{\"name\":\"x\",\"har\":\"examples/repository.har\",\"requests\":\"examples/repository.requests.json\",\"mode\":\"typo\"}]", "[{\"name\":\"x\",\"har\":\"examples/repository.har\",\"requests\":\"examples/repository.requests.json\",\"match_headers\":[1]}]"] {
    @fs.write_string_to_file(suite_path, invalid_suite)
    let rejected = @shell.Cmd("moon", ["run", "packages/suite", "--target", target, "--", suite_path]).output()
    assert_eq(rejected.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(rejected.stdout()), "diagnostic"), "code"), Json("suite_manifest_error"))
  }
  @fs.remove_file(suite_path)
  @fs.remove_file(suite_plan)
  for flags in [["--explain", "--explain"], ["--junit"], ["--junit", "--explain"], ["--unknown"]] {
    let command = ["run", "packages/suite", "--target", target, "--", "examples/regression.suite.json"]
    command.append(flags)
    let rejected = @shell.Cmd("moon", command).output()
    assert_eq(rejected.exit_code(), 2)
    assert_eq(report_field(report_field(@json.parse(rejected.stdout()), "diagnostic"), "code"), Json("usage_error"))
  }
  guard revised is { "log": { "entries": Array(entries), .. }, .. } else { abort("fixture entries missing") }
  guard entries[0] is { "response": Object(response), .. } else { abort("fixture response missing") }
  response.set("status", 404)
  let revised_path = "_build/echoreel-review-after.har"
  @fs.write_string_to_file(revised_path, revised.stringify())
  let review = @shell.Cmd("moon", ["run", "packages/review", "--target", target, "--", "examples/repository.har", revised_path]).output()
  assert_true(review.exit_code() != 0)
  assert_true(review.stdout().contains("\"kind\":\"status\""))
  @fs.remove_file(revised_path)
  println("verified \{target}: unit tests, real capture, SDK where supported, and CLI rejection paths")
}
